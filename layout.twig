<!doctype html>
<html class="no-js" lang="{{ page.seoLang }}">

    <head>
    	<meta charset="utf-8" />
    	<title>{{ page.title }}</title>
    	<meta name="keywords" content="{{ page.keywords }}" />
    	<meta name="description" content="{{ page.description }}" />

    	{% if site.favicon %}
    		<link rel="icon" href="{{ site.favicon['favicon'] }}" type="image/x-icon" />
    		<link rel="SHORTCUT ICON" href="{{ site.favicon['thumbnail'] }}?v={{ "now"|date("U") }}" type="image/x-icon" />
    	{% endif %}
    	<meta name="viewport" content="width=device-width,initial-scale=1">

        <script src="//ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    	{% include basekit.headScript %}
    </head>

    <body {{ isV10sSite ? 'id="migrated-site"' : '' }} class="{{ page.backgroundClass }}">

    	{% block content %}
    	{% endblock %}

        {% include basekit.bodyScript %}

        <script src="{{asset('js/fastclick.js')}}"></script>

        <script nonce="{{ numberUsedOnce }}">
            $(document).on("click", ".navigation-toggle", function() {
                $( ".bk-extendednavigation" ).toggleClass( "open" );
            });
        </script>

        <script nonce="{{ numberUsedOnce }}">
    		$(function() {
    		    FastClick.attach(document.body);
    		});

    		$( ".navigation-item.folder" ).each(function() {
    			$( this ).click(function() {
    	  			$( this ).toggleClass( "open" );
    			});
    		});
    	</script>

        <script type="text/javascript" nonce="{{ numberUsedOnce }}">
            $(document).scroll(function() {
              $(".feature__background-image").css("top","-" + $(document).scrollTop()/2 + "px");
            });
        </script>

    	{% block scripts %}
    	{% endblock %}
    </body>
</html>
